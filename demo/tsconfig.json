{
  "compilerOptions": {
    "paths": {
      "@metreeca/demo/*": [
        "./src/*"
      ],
      "@metreeca/skin": [
        "../src/index.ts"
      ]
    },
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
