{
  "name": "@metreeca/tile-apis",
  "version": "0.7.0",
  "description": "Preact API documentation widgets for @metreeca/tile.",
  "keywords": [
    "typescript",
    "preact",
    "json-ld",
    "model-driven",
    "ui",
    "api-documentation"
  ],
  "homepage": "https://metreeca.github.io/tile/",
  "bugs": {
    "url": "https://github.com/metreeca/tile/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/tile.git",
    "directory": "packages/tile-apis"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests run"
  },
  "devDependencies": {
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "preact": "^10.27.2"
  },
  "private": true
}
