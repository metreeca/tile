{
  "name": "@metreeca/tile-cell",
  "version": "0.6.1",
  "description": "Preact widgets and controls for @metreeca/tile interfaces.",
  "keywords": [
    "typescript",
    "preact",
    "json-ld",
    "model-driven",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/tile/",
  "bugs": {
    "url": "https://github.com/metreeca/tile/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/tile.git",
    "directory": "packages/tile-cell"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/icon.js"
  ],
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./icon": {
      "@metreeca/source": "./src/icon.ts",
      "default": "./dist/icon.js"
    },
    "./*": {
      "@metreeca/source": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.css": {
      "@metreeca/source": "./src/*.css",
      "default": "./dist/*.css"
    },
    "./*.core": null
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm dist docs node_modules '*.tsbuildinfo'",
    "build": "tsc -b tsconfig.build.json && cp dist 'src/*.css' 'src/*.md'",
    "check": "npx vitest --config ../../vitest.config.ts --root . --typecheck --passWithNoTests --environment happy-dom run"
  },
  "dependencies": {
    "@metreeca/core": "^0.13.0",
    "@metreeca/tile": "^0.6.1",
    "@metreeca/tile-data": "^0.6.1",
    "lucide-preact": "^1.47.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "preact": "^10.27.2"
  }
}
