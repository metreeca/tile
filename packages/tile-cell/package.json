{
  "name": "@metreeca/tile-cell",
  "version": "0.1.0",
  "description": "Preact widgets and controls for @metreeca/tile interfaces.",
  "keywords": [
    "typescript",
    "preact",
    "json-ld",
    "model-driven",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/tile/",
  "bugs": {
    "url": "https://github.com/metreeca/tile/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/tile.git",
    "directory": "packages/tile-cell"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "@metreeca/source": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*.css": {
      "@metreeca/source": "./src/*.css",
      "default": "./dist/*.css"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck --passWithNoTests run"
  },
  "dependencies": {
    "@metreeca/tile-skin": "^0.1.0",
    "lucide-preact": "^1.47.0"
  },
  "devDependencies": {
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "preact": "^10.27.2"
  }
}
