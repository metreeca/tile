{
  "name": "@metreeca/tile-skin",
  "version": "0.1.0",
  "description": "Design system for @metreeca/tile interfaces.",
  "keywords": [
    "typescript",
    "css",
    "design-system",
    "tokens",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/tile/",
  "bugs": {
    "url": "https://github.com/metreeca/tile/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/tile.git",
    "directory": "packages/tile-skin"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "@metreeca/source": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.css": {
      "@metreeca/source": "./src/*.css",
      "default": "./dist/*.css"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules *.tsbuildinfo",
    "build": "tsc -b tsconfig.build.json && rsync -a --include=\"*/\" --include=\"*.css\" --exclude=\"*\" src/ dist/",
    "check": "npx vitest --typecheck --passWithNoTests run"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
